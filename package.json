{
  "name": "@mfs-atomic/ui",
  "version": "1.3.4",
  "description": "Adaptive multi-theme Vue 3 UI component library with Claymorphism, Glassmorphism, and Neumorphism styles",
  "type": "module",
  "main": "./dist/mfs-theme.umd.cjs",
  "module": "./dist/mfs-theme.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mfs-theme.js",
      "require": "./dist/mfs-theme.umd.cjs"
    },
    "./style.css": "./dist/mfs-theme.css",
    "./dist/mfs-theme.css": "./dist/mfs-theme.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "ui-library",
    "components",
    "claymorphism",
    "glassmorphism",
    "neumorphism",
    "theme",
    "responsive"
  ],
  "author": "MFS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faris072/mfs-ui.git"
  },
  "homepage": "https://ui.mfstechnology.co.id",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --config vite.lib.config.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "lucide-vue-next": "^0.460.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5",
    "vue-tsc": "^2.2.12"
  }
}
